<!DOCTYPE html>
<html>
<head>
    <title>Edit Department</title>
</head>
<body>

<h1>Edit Department</h1>

<form action="/departments/edit/<%= department.department_id %>"
      method="POST">

    <label>Department Name</label>

    <br>

    <input
        type="text"
        name="department_name"
        value="<%= department.department_name %>"
        required>

    <br><br>

    <label>Description</label>

    <br>

    <input
        type="text"
        name="description"
        value="<%= department.description %>">

    <br><br>

    <button type="submit">
        Update Department
    </button>

</form>

</body>
</html>
