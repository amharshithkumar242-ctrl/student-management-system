<!DOCTYPE html>
<html>
<head>
    <title>Department Management</title>
</head>
<body>

    <h1>Department Management</h1>

    <hr>

    <a href="/dashboard">Dashboard</a>

    |

    <a href="/students">
        Student Management
    </a>

    |

    <a href="/logout">
        Logout
    </a>

    <hr>

    <a href="/departments/add">
        Add Department
    </a>

    <br><br>

    <table border="1" cellpadding="10">

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>

        <% departments.forEach(department => { %>

        <tr>

            <td>
                <%= department.department_id %>
            </td>

            <td>
                <%= department.department_name %>
            </td>

            <td>
                <%= department.description %>
            </td>

            <td>

                <a href="/departments/edit/<%= department.department_id %>">
                    Edit
                </a>

                &nbsp;

                <form
                    action="/departments/delete/<%= department.department_id %>"
                    method="POST"
                    style="display:inline">

                    <button type="submit">
                        Delete
                    </button>

                </form>

            </td>

        </tr>

        <% }) %>

    </table>

</body>
</html>